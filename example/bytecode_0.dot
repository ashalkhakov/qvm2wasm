digraph G
{
    n0 [ shape = "box"
             fontname = "Monospace"
             label = "<0(OpStackOut:1)>\l0:	OP_ENTER 8\l1:	OP_CONST 0\l2:	OP_LEAVE 8\l" ];
      n0 -> n2;
    n1 [ shape = "box"
             fontname = "Monospace"
             label = "<1(OpStackOut:-1)>\l3:	OP_PUSH\l" ];
      n1 -> n2;
    n2 [ shape = "box"
             fontname = "Monospace"
             label = "<2(OpStackOut:1)>\l4:	OP_LEAVE 8\l" ];
}
